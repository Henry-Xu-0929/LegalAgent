<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="{{t.archive.searchPlaceholder}}" value="{{searchInput}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" />
    <view class="search-action" bindtap="clearSearch">{{t.archive.clear}}</view>
  </view>
  <view class="category-row">
    <view
      class="category-chip {{activeCategory===item.value?'active':''}}"
      wx:for="{{categories}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onCategoryChange"
    >
      {{item.label}}
    </view>
  </view>
  <view class="section-title">{{t.archive.title}}</view>
  <view wx:if="{{isEmpty}}" class="empty-state">
    <view class="empty-title">{{t.archive.empty}}</view>
    <view class="empty-desc">{{t.archive.emptyDesc}}</view>
  </view>
  <view class="contract-list">
    <view class="contract-card" wx:for="{{filteredContracts}}" wx:key="id">
      <view class="contract-header">
        <view class="contract-title">{{item.title}}</view>
        <view class="category-tag">{{item.category}}</view>
      </view>
      <view class="contract-meta">{{t.archive.source}}：{{item.sourceType}} ｜ {{t.archive.status}}：{{item.displayStatus}} ｜ {{t.archive.version}}：{{item.displayVersionLabel}}</view>
      <view wx:if="{{item.caseTitle || item.caseKey}}" class="contract-meta">{{t.archive.case}}：{{item.caseTitle ? item.caseTitle : item.caseKey}}</view>
      <view class="contract-summary">{{item.summary}}</view>
      <view class="keyword-row">
        <view class="keyword-chip" wx:for="{{item.keywords}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="contract-time">{{t.archive.created}}：{{item.createdAt}} ｜ {{t.archive.updated}}：{{item.updatedAt}}</view>
      <view class="contract-actions">
        <view class="action-chip" data-id="{{item.id}}" bindtap="openContractDetail">{{t.archive.view}}</view>
        <view class="action-chip" data-id="{{item.id}}" bindtap="deleteContract">{{t.archive.delete}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{loading}}" class="loading-text">{{t.archive.loading}}</view>
  <view wx:if="{{!loading && contracts.length>0 && contracts.length>=total}}" class="loading-text">{{t.archive.noMore}}</view>
  <view wx:if="{{showDetail && activeContract}}" class="detail-mask" bindtap="closeContractDetail">
    <view class="detail-panel" catchtap="noop">
      <view class="detail-title">{{activeContract.title}}</view>
      <view class="detail-meta">{{t.archive.category}}：{{activeContract.category}} ｜ {{t.archive.source}}：{{activeContract.sourceType}}</view>
      <view wx:if="{{activeContract.caseTitle || activeContract.caseKey}}" class="detail-meta">{{t.archive.case}}：{{activeContract.caseTitle ? activeContract.caseTitle : activeContract.caseKey}}</view>
      <view class="detail-meta">{{t.archive.status}}：{{activeContract.displayStatus}} ｜ {{t.archive.version}}：{{activeContract.displayVersionLabel}}</view>
      <view wx:if="{{activeContract.fileName}}" class="detail-meta">{{t.archive.attachment}}：{{activeContract.fileName}}</view>
      <view wx:if="{{activeContract.manualEdited}}" class="detail-meta">{{t.archive.manualEdit}}：{{activeContract.manualEditCountLabel}} ｜ {{t.archive.recentEdit}}：{{activeContract.manualEditUpdatedAt || activeContract.updatedAt}}</view>
      <view class="detail-meta">{{t.archive.created}}：{{activeContract.createdAt}} ｜ {{t.archive.updated}}：{{activeContract.updatedAt}}</view>
      <view wx:if="{{!isEditing}}" class="detail-content">{{activeContract.content}}</view>
      <textarea
        wx:if="{{isEditing}}"
        class="detail-editor"
        value="{{editContent}}"
        maxlength="-1"
        auto-height
        show-confirm-bar="false"
        bindinput="onEditContentInput"
      />
      <view class="detail-actions">
        <view class="detail-btn primary" bindtap="toggleEditMode">{{isEditing ? (savingEdit ? t.archive.savingEdit : t.archive.saveEdit) : t.archive.editBtn}}</view>
        <view class="detail-btn" bindtap="exportContractWord">{{t.archive.exportWord}}</view>
        <view wx:if="{{activeContract.fileId}}" class="detail-btn secondary" bindtap="openContractWord">{{t.archive.openWord}}</view>
        <view class="detail-btn danger" data-id="{{activeContract.id}}" bindtap="deleteContract">{{t.archive.delete}}</view>
        <view class="detail-close" bindtap="closeContractDetail">{{t.archive.close}}</view>
      </view>
    </view>
  </view>
</view>
