<!--pages/my/my.wxml-->
<view class="container">
  <view class="header">
    <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
    <view class="info">
      <text class="nickname">{{userInfo.username}}</text>
      <text class="role">法律智能体用户</text>
    </view>
  </view>
  
  <view class="menu-list">
    <view class="menu-item">
      <text class="menu-title">关于我们</text>
      <image class="arrow" src="../../imgs/arrow.png"></image>
    </view>
    <view class="menu-item" bindtap="handleLogout">
      <text class="menu-title text-danger">退出登录</text>
      <image class="arrow" src="../../imgs/arrow.png"></image>
    </view>
  </view>
</view>