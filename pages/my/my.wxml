<!--pages/my/my.wxml-->
<view class="container">
  <view class="header">
    <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
    <view class="info">
      <text class="nickname">{{userInfo.username}}</text>
      <text class="role">{{t.mine.role}}</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item">
      <text class="menu-title">{{t.mine.about}}</text>
      <image class="arrow" src="../../imgs/arrow.png"></image>
    </view>
    <picker mode="selector" range="{{languageOptions}}" value="{{languageIndex}}" bindchange="handleLanguageChange">
      <view class="menu-item">
        <text class="menu-title">{{t.mine.language}}</text>
        <view class="menu-value">
          <text class="menu-value-text">{{languageLabel}}</text>
          <image class="arrow" src="../../imgs/arrow.png"></image>
        </view>
      </view>
    </picker>
    <view class="menu-item" bindtap="handleLogout">
      <text class="menu-title text-danger">{{t.mine.logout}}</text>
      <image class="arrow" src="../../imgs/arrow.png"></image>
    </view>
  </view>
</view>
