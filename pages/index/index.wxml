<view class="auth-page">
  <view class="brand">{{t.auth.brand}}</view>
  <view class="subtitle">{{t.auth.subtitle}}</view>
  <view class="tabs">
    <view class="tab {{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="switchMode">{{t.auth.login}}</view>
    <view class="tab {{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="switchMode">{{t.auth.register}}</view>
  </view>
  <view class="form">
    <input class="input" placeholder="{{t.auth.account}}" value="{{username}}" data-field="username" bindinput="handleInput" />
    <input class="input" placeholder="{{t.auth.password}}" password value="{{password}}" data-field="password" bindinput="handleInput" />
    <input wx:if="{{mode === 'register'}}" class="input" placeholder="{{t.auth.confirmPassword}}" password value="{{confirmPassword}}" data-field="confirmPassword" bindinput="handleInput" />
  </view>
  <button class="submit" bindtap="submit">{{mode === 'login' ? t.auth.login : t.auth.submitRegister}}</button>
</view>
