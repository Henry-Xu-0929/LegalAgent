<view class="feedback-modal" wx:if="{{isShowFeedback}}">
  <view class="feedback">
    <view class="feedback-header">
      {{t.feedback.header}}
    </view>
    <view class="feedback-body">
      <view class="item-box">
        <view class="item-title">{{t.feedback.rating}}</view>
        <view style="display: flex; gap: 14rpx;">
          <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
            <image src="{{item<=score?'./imgs/star-highlight.svg':'./imgs/star.svg'}}" mode="aspectFill" class="star" bind:touchend="onChangeScore" data-score="{{item}}" />
          </block>
        </view>
      </view>
      <view class="item-box">
        <view class="item-title">{{t.feedback.answerContent}}</view>
        <view>
          <block wx:for="{{feedbackType==='upvote'?upVote:downVote}}" wx:key="key">
            <view class="{{item.selected?'vote-item-highlight':'vote-item-normal'}}" bind:tap="onSelect" data-item="{{item}}">{{item.label}}</view>
          </block>
        </view>
      </view>
      <view class="item-box">
        <view class="item-title">{{t.feedback.suggestion}}</view>
        <view>
          <textarea value="{{message}}" class="feedback-textarea" maxlength="140" bindinput="inputChange"/>
        </view>
      </view>
    </view>
    <view class="feedback-footer">
      <view class="btn-cancel" bind:tap="closeShowFeedback">{{t.feedback.cancel}}</view>
      <view class="btn-submit" bind:tap="submitFeedback">{{t.feedback.submit}}</view>
    </view>
  </view>
</view>